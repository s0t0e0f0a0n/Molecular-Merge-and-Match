{
  "name": "molecular-merge-and-match",
  "version": "1.5.8",
  "description": "Molecular Bookkeeping for Structural Analysis",
  "main": "main.js",
  "devDependencies": {
    "electron": "41.6.1",
    "electron-builder": "26.14.0"
  },
  "scripts": {
    "clean:win": "if exist dist-electron rmdir /s /q dist-electron && if exist frontend\\dist rmdir /s /q frontend\\dist",
    "clean:unix": "rm -rf dist-electron frontend/dist",
    "clean": "npm run clean:win 2>nul || npm run clean:unix",
    "dist": "electron-builder --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.svdv.molecularmergeandmatch",
    "productName": "Molecular Merge and Match",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build-assets"
    },
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "frontend/dist/**/*",
      "build-assets/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin/",
        "to": "bin/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend/data",
        "to": "data",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build-assets/win/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${name}-Setup-${version}-${arch}.${ext}"
    },

    "portable": {
      "artifactName": "${name}-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "${name}-Setup-${version}-${arch}.${ext}",
      "icon": "build-assets/mac/icon_mac.icns",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "flatpak",
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "executableName": "molecularmergeandmatch",
      "artifactName": "${name}-Setup-${version}-${arch}.${ext}",
      "icon": "build-assets/icons/",
      "category": "Education",
      "synopsis": "Molecular Bookkeeping for Structural Analysis",
      "description": "An interactive NMR-based structure elucidation tool for university-level organic chemistry students..."
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "finishArgs": [
        "--share=network",
        "--share=ipc",
        "--socket=x11",
        "--socket=wayland",
        "--filesystem=xdg-documents",
        "--device=dri"
      ]
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s0t0e0f0a0n/Molecular-Merge-and-Match.git"
  },
  "keywords": [],
  "author": "S. van der Vorm & LUDev <s.van.der.vorm@chem.leidenuniv.nl>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/s0t0e0f0a0n/Molecular-Merge-and-Match/issues"
  },
  "homepage": "https://github.com/s0t0e0f0a0n/Molecular-Merge-and-Match#readme",
  "type": "commonjs"
}
