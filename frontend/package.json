{
  "name": "molecular-bookkeeping-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node -e \"const fs = require('fs'); fs.mkdirSync('public', { recursive: true }); fs.copyFileSync('node_modules/@rdkit/rdkit/dist/RDKit_minimal.js', 'public/RDKit_minimal.js'); fs.copyFileSync('node_modules/@rdkit/rdkit/dist/RDKit_minimal.wasm', 'public/RDKit_minimal.wasm');\"",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.21.0",
    "@blueprintjs/icons": "^6.14.1",
    "@blueprintjs/select": "^6.4.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "@zakodium/nmrium-core": "0.7.78",
    "@zakodium/nmrium-core-plugins": "0.7.110",
    "d3": "^7.9.0",
    "dompurify": "3.4.17",
    "jszip": "^3.10.1",
    "ketcher-core": "3.16.2",
    "ketcher-react": "3.16.2",
    "ketcher-standalone": "3.16.2",
    "nmr-processing": "22.25.3",
    "nmrium": "^2.8.0",
    "normalize.css": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@eslint/js": "^9.27.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.32.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.6"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
