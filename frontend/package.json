{
  "name": "molecular-bookkeeping-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node -e \"require('fs').mkdirSync('public', { recursive: true })\" && shx cp node_modules/@rdkit/rdkit/dist/RDKit_minimal.js public/ && shx cp node_modules/@rdkit/rdkit/dist/RDKit_minimal.wasm public/",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "jszip": "^3.10.1",
    "ketcher-core": "^3.12.0",
    "ketcher-react": "^3.12.0",
    "ketcher-standalone": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@eslint/js": "^9.27.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "jsdom": "^25.0.1",
    "shx": "^0.4.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.32.0",
    "vite": "^5.4.2",
    "vite-plugin-node-polyfills": "^0.26.0",
    "vitest": "^2.1.6"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
